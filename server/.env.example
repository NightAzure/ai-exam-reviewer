# ── AI Provider ───────────────────────────────────────────────────────────────
# Ollama is used by default when running (ollama serve).
# Set DISABLE_OLLAMA=true to force Gemini fallback.
# Optional: choose provider explicitly. Values: auto, ollama, gemini, bedrock.
# AI_PROVIDER=auto
# DISABLE_OLLAMA=true

# Optional: override the Ollama model (default: qwen2.5:14b-instruct).
# Any model tag listed by `ollama list` works — e.g. qwen2.5:7b-instruct, llama3.1:8b.
# OLLAMA_MODEL=qwen2.5:14b-instruct

# Optional: point FastAPI at a non-local Ollama server.
# Official Ollama env var; aliases OLLAMA_URL and OLLAMA_BASE_URL also work.
# OLLAMA_HOST=http://127.0.0.1:11434

# Required only when Ollama is unavailable or disabled.
# GOOGLE_GENERATIVE_AI_API_KEY=your-key-here

# Optional: override the Gemini model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Required only when AI_PROVIDER=bedrock.
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# BEDROCK_MAX_TOKENS=2048
# BEDROCK_TEMPERATURE=0.1
# BEDROCK_TOP_P=0.9
# BEDROCK_CONNECT_TIMEOUT_SECONDS=5
# BEDROCK_READ_TIMEOUT_SECONDS=90

# Durable question generation workers.
# SQS consumers should call POST /generate-questions/work with {"job_id": <id>}.
# GENERATION_WORKER_ID=fastapi-worker
# GENERATION_JOB_LEASE_SECONDS=300

# ── API Security ──────────────────────────────────────────────────────────────
# Optional fallback for service-to-service calls. User-facing AI calls use Supabase auth.
# Send this as X-API-Key when no user session is available.
# TUTOR_API_KEY=your-secret-key

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Defaults to http://localhost:3000 when not set.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Supabase (for sync script only) ──────────────────────────────────────────
# Copy these from your .env.local at the repo root.
# The URL + anon/publishable key let FastAPI verify user Supabase access tokens.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
