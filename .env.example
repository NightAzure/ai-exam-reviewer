# Copy to `.env.local` and fill in. Never commit `.env.local` to Git.

# Supabase (app + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: admin scripts / question_bank tools only
# SUPABASE_SERVICE_ROLE_KEY=

# Tutor backend (Ollama + FastAPI)
# Local dev: http://localhost:8000
# Shared GPU host: HTTPS URL from their tunnel (see server/HOME_GPU_PROXY.md)
FASTAPI_URL=http://localhost:8000
# Vercel/Next proxy timeout for the first upstream chat response chunk
# FASTAPI_CHAT_TIMEOUT_MS=55000
# Production question generation queue. When set, Next enqueues jobs to SQS
# and a worker should call POST ${FASTAPI_URL}/generate-questions/work.
# QUESTION_GENERATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/question-generation
# AWS_REGION=us-east-1
# Local fallback timeout for direct FastAPI generation worker calls.
# FASTAPI_GENERATION_WORK_TIMEOUT_MS=300000

# Optional service fallback for internal FastAPI calls.
# User-facing AI requests forward the signed-in user's Supabase access token.
TUTOR_API_KEY=

# FastAPI AI provider selection (server reads this too if env files are shared)
# AI_PROVIDER=auto
# AI_PROVIDER=bedrock requires AWS_REGION plus normal AWS credentials
